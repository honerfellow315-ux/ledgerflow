# Neon connection string — from your Neon project dashboard, "Connection string" (pooled).
# Example: postgresql://user:password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/ledgerflow?sslmode=require
DATABASE_URL=

# REQUIRED before deploying the security update. Encrypts admin 2FA secrets (and,
# later, sensitive staff fields). 32+ random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and NEVER change/lose it afterwards (encrypted values become unreadable).
AUTH_ENCRYPTION_KEY=
